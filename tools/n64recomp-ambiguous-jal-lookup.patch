+// Whether more than one relocatable section defines a function at this vram.
+//
+// Such an address does not identify a function. It identifies a slot that
+// several overlays take turns in, and which of them is resident is a runtime
+// question. `resolve_jal` cannot see this on its own: a jal carrying an
+// R_MIPS_26 reloc arrives with a section already chosen -- whichever tenant the
+// linker happened to attribute the symbol to when the ELF was built -- and that
+// choice is a guess wearing the clothes of a fact.
+static bool is_ambiguous_relocatable_target(const N64Recomp::Context& context, uint32_t target_func_vram) {
+    const auto matching_funcs_find = context.functions_by_vram.find(target_func_vram);
+    if (matching_funcs_find == context.functions_by_vram.end()) {
+        return false;
+    }
+
+    size_t relocatable_sections = 0;
+    size_t last_section_index = (size_t)-1;
+
+    for (size_t target_func_index : matching_funcs_find->second) {
+        const auto& target_func = context.functions[target_func_index];
+        if (target_func.words.empty() || (size_t)target_func.section_index >= context.sections.size()) {
+            continue;
+        }
+        if (!context.sections[target_func.section_index].relocatable) {
+            continue;
+        }
+        // Two symbols in one section at one vram are aliases, not a choice.
+        if ((size_t)target_func.section_index != last_section_index) {
+            last_section_index = target_func.section_index;
+            relocatable_sections++;
+        }
+    }
+
+    return relocatable_sections > 1;
+}
